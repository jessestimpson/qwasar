# build outputs
qwasar
qwasar-agent
qwasar-server
qwasar-bench
*.o
*.dSYM/
tools/bin2c

# compiled test binaries, but keep their sources
tests/test_*
!tests/test_*.c

# generated: embedded Metal sources (see Makefile / tools/bin2c.c)
qwasar_metal_src.inc
.metal_check.metal

# downloaded weights and the symlinks download_model.sh points at them
models/
qwasar-model
qwasar-mtp

# reference implementations, kept locally for study and for generating
# golden vectors; not part of this project
reference/

.DS_Store

# Crucible app build products
libqwasar.a
crucible/build/

# Generated from vendor/highlight.js/{core.min.js,langs/} by its build.sh.
# The pieces are vendored and reviewable; the concatenation is not committed,
# for the same reason qwasar_metal_src.inc is not.
crucible/vendor/highlight.js/highlight.bundle.js

# Elixir build artefacts. The guest image is built in Docker, which fetches
# deps itself; these only appear when the warden suites are run on the host.
# mix.lock is NOT ignored -- it pins what Docker resolves.
crucible/Guest/warden/_build/
crucible/Guest/warden/deps/
tools/venv/
tests/fixtures/flashnext-tiny/
tests/fixtures/flashnext-tiny-deq/
