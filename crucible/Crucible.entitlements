<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The M0 gate is that these four coexist with a 16 GB mmap in a signed
         bundle.  virtualization is available with an ordinary Developer ID and
         is not one of the restricted entitlements; com.apple.vm.networking is,
         and is deliberately absent (PLAN.md 8.1, 8.3). -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.virtualization</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- Outgoing connections only, for the HOST's own egress: fetch (spec
         8.3) and delegate (spec 15), both policy-gated in the app.  The
         GUEST still has no network device; com.apple.vm.networking stays
         deliberately absent, so even a misconfigured VM cannot get one.
         Without this entitlement a sandboxed connection fails with the
         misleading "hostname could not be found". -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
