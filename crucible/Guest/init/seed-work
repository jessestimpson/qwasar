# seed-work -- put the project into /work, ONCE.
#
# Sourced by crucible-init. A separate file so it can be run against a temp
# tree by test_seed_work.sh: this is the code that decides whether an hour of
# the model's work survives a restart, and "we reasoned about it carefully" is
# not the standard that deserves.
#
# Every path and both mount commands are overridable for that reason, and for
# no other. In the guest they are the defaults.
: "${WORK:=/work}"
: "${BASE:=/base}"
: "${SEED:=/var/lib/crucible/seeded}"
# How /base arrives, and goes away again. A test supplies `true` for both and
# populates $BASE itself.
: "${BASE_MOUNT:=mount -t virtiofs base $BASE}"
: "${BASE_UMOUNT:=umount $BASE}"

# Stand-alone when the caller has no log of its own.
command -v log >/dev/null 2>&1 || log() { echo "$*"; }

seed_work() {
    mkdir -p "$WORK" "$BASE" "$(dirname "$SEED")"

    # Either the marker or the baseline is proof this disk has been seeded.
    #
    # The marker lives OUTSIDE $WORK deliberately: /work is the one directory
    # the agent is invited to change, and a marker inside it is a marker the
    # agent can delete -- turning a stray `rm` into silent data loss on the next
    # boot. The baseline check is what adopts disks made before the marker
    # existed; without it the first boot after this change would re-copy over
    # work already in progress, which is the exact loss it exists to prevent.
    if [ -f "$SEED" ] || [ -d "$WORK/.crucible-git" ]; then
        log "resuming: keeping $WORK as the last session left it ($(find "$WORK" -type f 2>/dev/null | wc -l | tr -d ' ') files)"
        if [ ! -f "$SEED" ]; then
            : > "$SEED" && sync
            log "adopted a disk from before the seed marker"
        fi
        [ -d "$WORK/.crucible-git" ] || log "WARNING: the baseline is gone; changes cannot be proposed"
        return 0
    fi

    if ! $BASE_MOUNT 2>/dev/null; then
        log "no project share attached; $WORK is empty"
        return 0
    fi

    log "copying the project into $WORK"
    cp -a "$BASE/." "$WORK/" 2>/dev/null || log "copy incomplete (see the host's exclusions)"
    $BASE_UMOUNT 2>/dev/null || true
    log "copied $(find "$WORK" -type f 2>/dev/null | wc -l | tr -d ' ') files"

    # The baseline: what the project looked like before the agent touched it.
    #
    # A separate git dir, so a project that is ITSELF a git repository is not
    # disturbed -- $WORK/.git stays exactly as it was copied, and this one lives
    # beside it. Git is the diff engine because it already solves renames,
    # modes, binary files and line endings, and the image is carrying it anyway.
    if GIT_DIR="$WORK/.crucible-git" GIT_WORK_TREE="$WORK" sh -c '
            git init -q \
              && git config user.email crucible@localhost \
              && git config user.name Crucible \
              && git add -A \
              && git commit -q -m baseline --allow-empty' 2>/dev/null; then
        log "baseline recorded ($(GIT_DIR="$WORK/.crucible-git" git rev-parse --short HEAD 2>/dev/null))"
        # Only now. A half-seeded $WORK must be seeded AGAIN on the next boot,
        # not mistaken for the model's work and preserved.
        : > "$SEED" && sync
    else
        log "WARNING: no baseline; changes cannot be proposed"
    fi
}
