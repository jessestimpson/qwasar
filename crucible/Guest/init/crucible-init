#!/bin/sh
# crucible-init -- PID 1 in the guest.
#
# PLAN.md 6.2: not OpenRC. Every second here is a second the user waits before
# the model can do anything, on every session resume, so this does the four
# things that must happen and then hands over.
#
# It is also the last line of defence for a property the host cares about: the
# project tree arrives read-only over virtiofs and is COPIED into the guest's
# own disk. Nothing after this point can write to what the host shared, because
# nothing after this point has it mounted writable.

set -u

# One destination. stdout is already the console, and writing to both printed
# every line twice.
# Boot time is a tracked number (PLAN.md 6.2): every second here is a second
# the user waits before the model can act, on every session resume. So the log
# carries the clock, and the profile is visible rather than guessed at.
up() { awk '{printf "%6.2f", $1}' /proc/uptime 2>/dev/null || echo "  ?  "; }
log() { echo "[$(up)] $*"; }

# The initramfs hands root over read-only regardless of the `rw` on the command
# line, so the first thing that has to happen is a remount -- without it every
# mkdir below fails and the guest boots into a useless read-only box.
mount -o remount,rw / 2>/dev/null || log "WARNING: root is still read-only"

mount -t proc     proc     /proc 2>/dev/null || true
mount -t sysfs    sysfs    /sys  2>/dev/null || true
mount -t devtmpfs devtmpfs /dev  2>/dev/null || true
mount -t tmpfs    tmpfs    /run  2>/dev/null || true
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts 2>/dev/null || true

log "kernel $(uname -r)"
log "root is $(awk '$2=="/" {print $4}' /proc/mounts | head -1)"

# The control channel's transport. Built as a module in linux-virt, so it has
# to be asked for by name.
# virtio_rng is the driver for the host's entropy device. The device being
# attached is not enough -- without the module the kernel's random pool is
# unseeded and anything calling getrandom() blocks until it fills, which in a
# VM with no devices and no user is a very long time.
for m in virtio_rng rng_core vsock vmw_vsock_virtio_transport_common vmw_vsock_virtio_transport virtiofs; do
    modprobe "$m" 2>/dev/null && log "loaded $m" || true
done

# /work is the guest's own copy. /base is the host's tree, read-only, and is
# unmounted as soon as the copy is done so it cannot be reached later.
#
# The logic lives in seed-work, sourced rather than inlined, so that
# test_seed_work.sh can run it against a temp tree -- it decides whether an
# hour of the model's work survives a restart, and the build gates on it.
. /sbin/seed-work
seed_work

# Loopback, and only loopback.
#
# Erlang distribution runs over TCP even when both nodes are on the same
# machine, so warden and the workspace need `lo` up or epmd fails to listen with
# `enetunreach` and the BEAM exits. This does NOT weaken PLAN.md 8.2: the VM is
# configured with no network *device* at all, so there is no interface for
# anything to leave by. This is a socket between two processes that happens to
# speak TCP.
ip link set lo up 2>/dev/null || ifconfig lo 127.0.0.1 up 2>/dev/null || \
    log "WARNING: no loopback; the workspace node will not be reachable"

hostname crucible 2>/dev/null || true

# DO NOT REMOVE. This line is worth 5.1 seconds of every boot.
#
# The BEAM resolves the local hostname while starting, and with no entry for it
# and no nameserver to ask, that lookup waits out the resolver's timeout --
# measured at 5.14 s for a bare `erl -eval 'halt(0).'`, which reads as a
# pathologically slow runtime rather than as a name lookup. Boot-to-warden-ready
# went 5.68 s -> 0.63 s when this appeared.
#
# Isolated deliberately: an entropy device plus virtio_rng was the other
# candidate and was tested separately. It made no difference; this did.
printf '127.0.0.1 localhost crucible\n::1 localhost crucible\n' > /etc/hosts 2>/dev/null || true

# mise's runtimes, for the agent and for anything running in /work. The warden
# itself does NOT go through mise (see the Dockerfile): its erl is a concrete
# path, so nothing the agent does to a mise config can stop the control plane
# from restarting.
# PID 1 inherits whatever PATH the kernel gave it, which is close to nothing.
# Anything that shells out -- including the warden asking mise what runtimes
# exist -- needs this spelled out, or it fails with a "command not found" that
# gets reported as the feature being absent.
export PATH=/opt/mise/shims:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export MISE_DATA_DIR=/opt/mise
export MISE_CONFIG_DIR=/etc/mise

# HOME must be set before any BEAM starts: distribution nodes authenticate with
# $HOME/.erlang.cookie, which the first node creates and the second reads. With
# no HOME they disagree and the workspace is unreachable for a reason that
# reports itself as `nodedown`.
export HOME=/root
mkdir -p /root

log "starting warden"
cd /opt/warden || exit 1
log "starting the BEAM"


# The bridge and the warden are one pipeline: vsock_port owns the socket and
# speaks stdio, the BEAM opens it as a {packet,4} port. If either dies the
# supervisor here restarts the pair, because a half-open bridge is worse than
# no bridge.
# A poweroff request from the host arrives as SIGUSR1 to PID 1 under Linux's
# reboot-notifier convention; without handling it the host's requestStop() is
# ignored and it waits forever for a guest that has no intention of stopping.
trap 'log "host asked us to stop"; sync; poweroff -f' USR1
trap 'log "host asked us to stop"; sync; poweroff -f' TERM

# erl directly, with the warden already compiled. Not `elixir`, which is a
# shell script that starts the compiler; see the Dockerfile for the 5.31 s that
# bought.
# ERL_LIBS rather than a pile of -pa flags: Elixir ships elixir, logger, mix and
# the rest as separate OTP applications, and warden depends on logger. Putting
# only elixir/ebin on the path started the BEAM and then failed with
# {error,{logger,"no such file or directory"}} -- which, because the first
# attempt did not check the result, presented as a guest that booted and then
# said nothing at all.
export ERL_LIBS="$(cat /etc/crucible-erl-libs 2>/dev/null)"

while true; do
    # The match is the point: a warden that fails to start must crash loudly
    # here, not block forever on a `receive` while the host waits out its
    # connection timeout.
    # -sname, because warden spawns the agent's node and talks to it over Erlang
    # distribution (PLAN.md 7.3). Both nodes are on loopback inside the guest;
    # nothing is listening outside it, and there is no network device for
    # anything to listen on.
    /usr/bin/erl -noshell -sname warden -boot no_dot_erlang -pa /opt/warden/ebin \
        -eval '{ok, _} = application:ensure_all_started(warden), receive after infinity -> ok end.'
    log "warden exited ($?); restarting in 1s"
    sleep 1
done
