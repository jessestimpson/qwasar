<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>                  <string>Qwasar</string>
    <key>CFBundleDisplayName</key>           <string>Qwasar</string>
    <key>CFBundleIdentifier</key>            <string>dev.qwasar.Qwasar</string>
    <key>CFBundleExecutable</key>            <string>Qwasar</string>
    <key>CFBundlePackageType</key>           <string>APPL</string>
    <key>CFBundleShortVersionString</key>    <string>0.2.0</string>
    <key>CFBundleVersion</key>               <string>1</string>
    <key>LSMinimumSystemVersion</key>        <string>14.0</string>
    <!-- A menu bar item; the coding agent's window opens on request. -->
    <key>LSUIElement</key>                   <true/>
    <key>NSHighResolutionCapable</key>       <true/>
    <key>LSApplicationCategoryType</key>     <string>public.app-category.developer-tools</string>
    <!-- Filled in by the Makefile: the checkout's qwasar-model link, and its
         models/ directory, where the Model menu looks first. -->
    <key>QWDefaultModel</key>                <string></string>
    <key>QWModelsDir</key>                   <string></string>
</dict>
</plist>
