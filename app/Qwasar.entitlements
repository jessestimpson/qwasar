<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Not App Sandboxed, and nothing granted.  A session's tools run on
         this Mac, as the user with their shell environment (HostToolRunner),
         which is impossible under App Sandbox: everything a sandboxed app
         starts inherits its sandbox, so `bash` could reach neither the
         user's files nor their toolchains.  The Makefile still signs with
         the hardened runtime. -->
</dict>
</plist>
