<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The headless gates' entitlements.  The same as Qwasar.entitlements
         now that the app is not App Sandboxed: there is no folder grant for
         a terminal to be unable to click, so the gates run the shipping
         configuration as is. -->
    <key>com.apple.security.virtualization</key>
    <true/>
</dict>
</plist>
